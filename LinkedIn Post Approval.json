        "sendTo": "pmounikha@gmail.com",
        "subject": "LinkedIn Post - Approval Required",
        "message": "=Hi,\n\nA new LinkedIn post has been generated and reviewed by our AI agents.\n\nTopic:\n{{ $('On form submission').item.json.Topic }}\n\nReviewed LinkedIn Post:\n\n{{ $json.output }}\n\nPlease review the above content and select Approve or Reject.\n\nApprove: Accept the post for further processing.\nReject: Discard the post.\n\nThank you.",
        "approvalOptions": {
